// Разметка главного окна NotepadM.
// Концептуальный аналог MainForm.fxml из JavaFX-версии:
// декларативное описание интерфейса, отделённое от логики (src/main.rs).

import { LineEdit, Button, CheckBox, Palette, ScrollView } from "std-widgets.slint";

// Структура «инфо о вкладке» — общая для разметки и Rust-кода:
// компилятор Slint сгенерирует одноимённый Rust-тип TabInfo.
export struct TabInfo {
    title: string,
    dirty: bool,
}

// Кнопка-крестик (закрыть вкладку, спрятать панель поиска).
// Крестик рисуем векторно (Path), а не символом шрифта: глифа «✕»
// может не быть в системном шрифте (на Windows вместо него — квадратик),
// и в разных шрифтах он выглядит по-разному.
component CloseButton inherits Rectangle {
    callback clicked;
    width: 18px;

    area := TouchArea {
        clicked => { root.clicked(); }
    }

    // Фон-подсветка под курсором, как в браузерах.
    Rectangle {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: area.has-hover ? #d0303028 : transparent;

        Path {
            width: 8px;
            height: 8px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 8 8 M 8 0 L 0 8";
            stroke: area.has-hover ? #d03030 : Palette.foreground;
            stroke-width: 1.5px;
        }
    }
}

// Редактор — свой компонент вместо стандартного TextEdit из std-widgets.
// Причина: TextEdit не отдаёт наружу позицию курсора, а строке состояния
// она нужна. Устройство повторяет внутренний TextEditBase самого Slint:
// низкоуровневый элемент TextInput внутри ScrollView.
component Editor inherits Rectangle {
    in-out property <string> text <=> input.text;
    // Позиция курсора: байтовое смещение (UTF-8) от начала текста.
    out property <int> cursor-offset: input.cursor-position-byte-offset;

    callback edited(text: string);
    callback cursor-moved(offset: int);

    background: Palette.control-background;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: input;

    public function set-selection-offsets(start: int, end: int) {
        input.set-selection-offsets(start, end);
    }

    public function cut() { input.cut(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }

    // Контекстное меню правой кнопки — у TextEdit оно было встроенным,
    // здесь объявляем своё (заодно с русскими надписями).
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Вырезать";
                activated => { input.cut(); }
            }
            MenuItem {
                title: "Копировать";
                activated => { input.copy(); }
            }
            MenuItem {
                title: "Вставить";
                activated => { input.paste(); }
            }
            MenuItem {
                title: "Выделить всё";
                activated => { input.select-all(); }
            }
        }

        scroll := ScrollView {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            viewport-width: self.visible-width;
            viewport-height: max(self.visible-height, input.preferred-height);

            input := TextInput {
                enabled: true;
                single-line: false;
                wrap: word-wrap;
                color: Palette.foreground;
                selection-background-color: Palette.selection-background;
                selection-foreground-color: Palette.selection-foreground;
                page-height: scroll.visible-height;

                edited => { root.edited(self.text); }

                // Срабатывает при любом изменении свойства (change callback).
                changed cursor-position-byte-offset => {
                    root.cursor-moved(self.cursor-position-byte-offset);
                }

                // TextInput сам не прокручивается вслед за курсором — это
                // обязанность обёртки. Логика (включая запас 20px на высоту
                // строки) взята из TextEditBase Slint.
                cursor-position-changed(cpos) => {
                    if (cpos.x + scroll.viewport-x < 0px) {
                        scroll.viewport-x = min(0px, max(scroll.visible-width - self.width, -cpos.x));
                    } else if (cpos.x + scroll.viewport-x > scroll.visible-width) {
                        scroll.viewport-x = min(0px, max(scroll.visible-width - self.width, scroll.visible-width - cpos.x));
                    }
                    if (cpos.y + scroll.viewport-y < 0px) {
                        scroll.viewport-y = min(0px, scroll.visible-height - cpos.y - 20px, max(scroll.visible-height - self.height, -cpos.y));
                    } else if (cpos.y + scroll.viewport-y > scroll.visible-height - 20px) {
                        scroll.viewport-y = min(0px, max(scroll.visible-height - self.height, scroll.visible-height - cpos.y - 20px));
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: root.tabs.length == 0
        ? "NotepadM"
        : "NotepadM — " + root.tabs[root.current-tab].title
          + (root.tabs[root.current-tab].dirty ? " *" : "");
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 400px;
    min-height: 300px;
    // Иконка окна (панель задач / заголовок). @image-url встраивает
    // картинку в бинарник на этапе компиляции — отдельных файлов
    // рядом с .exe не нужно.
    icon: @image-url("images/NotepadM.png");

    // Список вкладок. [TabInfo] — модель: Rust кладёт сюда VecModel,
    // и блок for ниже автоматически перестраивается при изменениях.
    in-out property <[TabInfo]> tabs;
    // Индекс активной вкладки.
    in-out property <int> current-tab;
    // Текст активного документа (двусторонняя привязка к TextEdit).
    in-out property <string> document-text;
    // Панель поиска: видимость и строка статуса («3/17», «Не найдено»…).
    in-out property <bool> search-visible: false;
    in-out property <string> search-status;
    // Строка состояния: позиция курсора, размер текста, кодировка.
    // Тексты готовит Rust — разметка их только показывает.
    in-out property <string> status-caret;
    in-out property <string> status-size;
    in-out property <string> status-encoding;
    // Позиция курсора редактора — для чтения из Rust-кода.
    out property <int> editor-cursor: editor.cursor-offset;

    // Callbacks — «сигналы» в сторону Rust-кода.
    callback new-file();
    callback open-file();
    callback save-file();
    callback save-file-as();
    callback preview-in-browser();
    callback quit();
    callback show-about();
    callback select-tab(int);
    callback close-tab(int);
    callback text-edited(string);
    callback cursor-moved(int);
    // Поиск/замена: (что искать, [на что менять,] учитывать регистр).
    callback find-next(string, bool);
    callback replace-one(string, string, bool);
    callback replace-all(string, string, bool);

    // Публичная функция — Rust вызывает её, чтобы подсветить найденное
    // (invoke_highlight на стороне Rust).
    public function highlight(start: int, end: int) {
        editor.set-selection-offsets(start, end);
        editor.focus();
    }

    // Открыть панель поиска с фокусом в нужном поле.
    function open-search(to-replace: bool) {
        root.search-visible = true;
        if (to-replace) {
            replace-input.focus();
        } else {
            search-input.focus();
        }
    }

    MenuBar {
        Menu {
            title: "Файл";
            MenuItem {
                title: "Новый";
                icon: @image-url("images/New.png");
                activated => { root.new-file(); }
            }
            MenuItem {
                title: "Открыть…";
                icon: @image-url("images/Open.png");
                activated => { root.open-file(); }
            }
            MenuItem {
                title: "Сохранить";
                icon: @image-url("images/Save.png");
                activated => { root.save-file(); }
            }
            MenuItem {
                title: "Сохранить как…";
                icon: @image-url("images/Save.png");
                activated => { root.save-file-as(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Предпросмотр в браузере";
                activated => { root.preview-in-browser(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Выход";
                icon: @image-url("images/Exit.png");
                activated => { root.quit(); }
            }
        }
        Menu {
            title: "Правка";
            MenuItem {
                title: "Вырезать";
                icon: @image-url("images/Cut.png");
                activated => { editor.cut(); }
            }
            MenuItem {
                title: "Копировать";
                icon: @image-url("images/Copy.png");
                activated => { editor.copy(); }
            }
            MenuItem {
                title: "Вставить";
                icon: @image-url("images/Paste.png");
                activated => { editor.paste(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Найти…";
                icon: @image-url("images/Find.png");
                activated => { root.open-search(false); }
            }
            MenuItem {
                title: "Заменить…";
                activated => { root.open-search(true); }
            }
        }
        Menu {
            title: "Справка";
            MenuItem {
                title: "О программе";
                activated => { root.show-about(); }
            }
        }
    }

    // FocusScope ловит горячие клавиши. Нажатия, которые не обработал
    // сфокусированный элемент (редактор, поле ввода), «всплывают» сюда.
    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text.to-lowercase() == "n") { root.new-file(); return accept; }
                if (event.text.to-lowercase() == "o") { root.open-file(); return accept; }
                if (event.text.to-lowercase() == "s" && event.modifiers.shift) { root.save-file-as(); return accept; }
                if (event.text.to-lowercase() == "s") { root.save-file(); return accept; }
                if (event.text.to-lowercase() == "f") { root.open-search(false); return accept; }
                if (event.text.to-lowercase() == "h") { root.open-search(true); return accept; }
                if (event.text.to-lowercase() == "w") { root.close-tab(root.current-tab); return accept; }
            }
            if (event.text == Key.F3) {
                root.find-next(search-input.text, case-box.checked);
                return accept;
            }
            if (event.text == Key.Escape && root.search-visible) {
                root.search-visible = false;
                editor.focus();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // Панель инструментов — как JToolBar в Swing-версии.
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                alignment: start;

                Button {
                    icon: @image-url("images/New.png");
                    clicked => { root.new-file(); }
                }
                Button {
                    icon: @image-url("images/Open.png");
                    clicked => { root.open-file(); }
                }
                Button {
                    icon: @image-url("images/Save.png");
                    clicked => { root.save-file(); }
                }
                Button {
                    icon: @image-url("images/Cut.png");
                    clicked => { editor.cut(); }
                }
                Button {
                    icon: @image-url("images/Copy.png");
                    clicked => { editor.copy(); }
                }
                Button {
                    icon: @image-url("images/Paste.png");
                    clicked => { editor.paste(); }
                }
                Button {
                    icon: @image-url("images/Find.png");
                    clicked => { root.open-search(false); }
                }
            }

            // Панель поиска/замены. Не через `if` — к элементам внутри
            // условных блоков нельзя обращаться извне (нужен focus()),
            // поэтому панель всегда существует, но схлопывается в 0 по высоте.
            search-panel := Rectangle {
                visible: root.search-visible;
                height: root.search-visible ? search-content.preferred-height : 0px;
                clip: true;
                background: Palette.alternate-background;

                search-content := VerticalLayout {
                    padding: 6px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;

                        search-input := LineEdit {
                            placeholder-text: "Найти…";
                            // Enter в поле — искать дальше.
                            accepted(text) => { root.find-next(text, case-box.checked); }
                        }
                        Button {
                            text: "Найти далее (F3)";
                            clicked => { root.find-next(search-input.text, case-box.checked); }
                        }
                        case-box := CheckBox {
                            text: "Учитывать регистр";
                            checked: true;
                        }
                        Text {
                            text: root.search-status;
                            vertical-alignment: center;
                        }
                        CloseButton {
                            clicked => {
                                root.search-visible = false;
                                editor.focus();
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        replace-input := LineEdit {
                            placeholder-text: "Заменить на…";
                        }
                        Button {
                            text: "Заменить";
                            clicked => { root.replace-one(search-input.text, replace-input.text, case-box.checked); }
                        }
                        Button {
                            text: "Заменить все";
                            clicked => { root.replace-all(search-input.text, replace-input.text, case-box.checked); }
                        }
                    }
                }
            }

            // Панель вкладок: по одному «ярлыку» на каждый элемент модели tabs.
            // Без alignment: когда места мало, layout ужимает вкладки
            // (заголовки обрезаются многоточием), а заполнитель в конце
            // не даёт им растягиваться на всю ширину, пока места хватает.
            HorizontalLayout {
                height: 34px;

                for tab[i] in root.tabs: Rectangle {
                    horizontal-stretch: 0;
                    max-width: 180px;
                    background: i == root.current-tab
                        ? Palette.background
                        : Palette.alternate-background;
                    border-width: 1px;
                    border-color: Palette.border;

                    // Клик по всей вкладке — переключение.
                    TouchArea {
                        clicked => { root.select-tab(i); }
                    }

                    // Содержимое объявлено после TouchArea, поэтому кнопка
                    // закрытия перехватывает клики поверх него.
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;

                        Text {
                            text: tab.dirty ? tab.title + " *" : tab.title;
                            vertical-alignment: center;
                            // elide: текст можно ужимать, лишнее заменяется «…»
                            overflow: elide;
                            color: Palette.foreground;
                        }

                        CloseButton {
                            clicked => { root.close-tab(i); }
                        }
                    }
                }

                // Заполнитель: забирает свободное место справа от вкладок.
                Rectangle {}
            }

            editor := Editor {
                text <=> root.document-text;
                // Срабатывает только на ввод пользователя,
                // не на программное изменение text из Rust.
                edited(text) => { root.text-edited(text); }
                cursor-moved(offset) => { root.cursor-moved(offset); }
            }

            // Строка состояния.
            Rectangle {
                background: Palette.alternate-background;
                height: status-bar.preferred-height;

                status-bar := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 24px;

                    Text { text: root.status-caret; }
                    Text { text: root.status-size; }
                    // Распорка: кодировка прижимается к правому краю.
                    Rectangle {}
                    Text { text: root.status-encoding; }
                }
            }
        }
    }
}
